# Required: server-side only. Never expose this value to Vite or the browser.
ANTHROPIC_API_KEY=

# PostgreSQL. Run `docker compose up -d db`, then `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://travelbuddy:travelbuddy@localhost:5432/travelbuddy

# Optional
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# AI model routing and bounded resilience. Defaults are shown here.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5
MAX_AGENT_RETRIES=2
LLM_TIMEOUT_SECONDS=180
LLM_QUEUE_TIMEOUT_SECONDS=12
LLM_MAX_CONCURRENT_CALLS=5
# Keep this below the total cap to reserve capacity for onboarding/itineraries.
LLM_MAX_RESEARCH_CONCURRENT_CALLS=4
LLM_MAX_WEB_SEARCH_CALLS=3
# Resuming a paused server-side web-search loop is one turn, not a retry.
LLM_MAX_PAUSE_CONTINUATIONS=3
# Deterministic context is faster; opt into a prose rewrite only if evaluated.
LLM_ENHANCE_CONTEXT_BRIEF=false
LLM_RETRY_BASE_DELAY_SECONDS=0.4
LLM_RETRY_MAX_DELAY_SECONDS=4
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
AGENT_DEADLINE_SECONDS=300
ITINERARY_DEADLINE_SECONDS=360
CONTEXT_BRIEF_TIMEOUT_SECONDS=45
SSE_HEARTBEAT_SECONDS=15

# Optional LLM gateway (LiteLLM, Anthropic-native passthrough). Kill switch:
# false talks straight to api.anthropic.com with app-side resilience only.
LLM_GATEWAY_ENABLED=false
LLM_GATEWAY_BASE_URL=http://localhost:4000/anthropic
# Gateway virtual key (never the real provider key). Required when enabled.
LLM_GATEWAY_API_KEY=
# Admin key for the gateway container itself (docker compose --profile gateway up).
LITELLM_MASTER_KEY=

# Third app-side fallback model (chain: primary -> fallback -> fallback_2).
ANTHROPIC_FALLBACK_MODEL_2=claude-haiku-4-5

# Taste-aware research cache: exact trip facts, fuzzy taste (cosine >= margin).
LLM_CACHE_ENABLED=true
CACHE_TASTE_MARGIN=0.90
CACHE_TTL_SECONDS=21600
CACHE_BUDGET_BUCKET_PCT=10

# PII posture: prompts contain personal profiles. The app logs only a prompt
# hash; gateway message capture stays off unless this is deliberately true.
LLM_LOG_PROMPTS=false
LLM_LOG_RETENTION_DAYS=30

# Optional hotel/flight inventory. "unavailable" is the safe default.
# "demo" returns clearly-labelled, non-live sample data for UI development.
# "duffel" requires a server-side token; never expose it to Vite or the browser.
INVENTORY_PROVIDER=unavailable
DUFFEL_ACCESS_TOKEN=
# Must match the environment and permissions of the configured Duffel token.
DUFFEL_MODE=test
DUFFEL_API_BASE_URL=https://api.duffel.com
INVENTORY_HTTP_TIMEOUT_SECONDS=25
# Saved-shortlist lifetime only. This is not a supplier quote or reservation hold.
CART_TTL_MINUTES=60

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
