# Required: server-side only. Never expose this value to Vite or the browser.
OPENAI_API_KEY=

# PostgreSQL. Run `docker compose up -d db`, then `alembic upgrade head`.
DATABASE_URL=postgresql+psycopg://travelbuddy:travelbuddy@localhost:5432/travelbuddy

# Optional
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# AI model routing and bounded resilience. Defaults are shown here.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
MAX_AGENT_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_QUEUE_TIMEOUT_SECONDS=12
LLM_MAX_CONCURRENT_CALLS=5
# Keep this below the total cap to reserve capacity for onboarding/itineraries.
LLM_MAX_RESEARCH_CONCURRENT_CALLS=4
LLM_MAX_WEB_SEARCH_CALLS=3
# Deterministic context is faster; opt into a prose rewrite only if evaluated.
LLM_ENHANCE_CONTEXT_BRIEF=false
LLM_RETRY_BASE_DELAY_SECONDS=0.4
LLM_RETRY_MAX_DELAY_SECONDS=4
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30
AGENT_DEADLINE_SECONDS=150
ITINERARY_DEADLINE_SECONDS=180
CONTEXT_BRIEF_TIMEOUT_SECONDS=12
SSE_HEARTBEAT_SECONDS=15

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
